# Copy to .env and fill in. NEVER commit .env or your SSH key.

# ---- Phoenix ERP mock (URL + your team token are on Builder Base) ----
# For offline dev you can run the bundled mock:
#   uvicorn app.mock.phoenix:app --port 8009   (from ./backend)
#   PHOENIX_API_BASE_URL=http://localhost:8009
PHOENIX_API_BASE_URL=https://REPLACE-with-the-phoenix-url-from-builder-base
PHOENIX_API_TOKEN=replace-with-your-team-token

# ---- SSH access to the customer VMs ----
# Put case1_key.pem … case5_key.pem in ./keys/ (mounted at /keys in Docker).
# Point this at any key in that folder; the backend auto-picks case{N} for ticket 700N.
SSH_PRIVATE_KEY_PATH=/keys/case1_key.pem
SSH_USERNAME=azureuser
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=45

# ---- LLM via OpenRouter (bring your own key) ----
# OpenRouter is OpenAI-compatible. Use a strong model for reasoning and a fast
# model for verification/activity drafting. Example slugs (set your own):
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=openai/gpt-5.5
FAST_MODEL=openai/gpt-5.5-mini

# ---- Autonomous agent ----
# The agent runs as one continuous tool-calling conversation. History is compacted
# (summarised) once it grows past COMPACT_THRESHOLD * MAX_TOKENS of the window.
AGENT_CONTEXT_MAX_TOKENS=200000
AGENT_CONTEXT_COMPACT_THRESHOLD=0.8
AGENT_CONTEXT_KEEP_RECENT_MESSAGES=20
# Hard cap on tool-call rounds (safety net against runaway loops).
AGENT_MAX_ITERATIONS=60
# OpenRouter reasoning effort: low | medium | high (empty to disable thinking).
AGENT_REASONING_EFFORT=medium

# When true, read-only/safe commands run without a prompt; mutations always need
# approval. Toggle per-run from the UI.
AUTO_APPROVE_READS_DEFAULT=true

# ---- ElevenLabs voice agent (optional — enables hands-free run steering) ----
# Create an Agent at https://elevenlabs.io/app/agents and paste its id + an API key.
# The API key stays on the backend; the browser only ever gets a short-lived signed URL.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ---- Frontend ----
VITE_API_BASE=http://localhost:8000
